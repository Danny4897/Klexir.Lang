<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>klexir</AssemblyName>
    <RootNamespace>Klexir.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>klexir</ToolCommandName>
    <PackageId>Klexir.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Danny4897</Authors>
    <Description>Klexir language CLI — run/compile .klx files, scaffold new projects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klexir.Lang\Klexir.Lang.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project scaffold for 'klexir new' — copied next to the built exe so it's found via AppContext.BaseDirectory. -->
    <None Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
