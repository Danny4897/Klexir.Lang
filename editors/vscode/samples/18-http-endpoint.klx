// Un endpoint HTTP vero: klexir serve chiama questa funzione una volta per ogni richiesta reale.
// Esegui con: klexir serve --port=5000 18-http-endpoint.klx
// poi: curl http://localhost:5000/hello
record HttpRequest { Method: String, Path: String, Body: String };
record HttpResponse { Status: Int, Body: String };

let handleRequest = func(HttpRequest req) =>
    if req.Path == "/hello" then HttpResponse { Status: 200, Body: "ciao dal server Klexir" }
    else HttpResponse { Status: 404, Body: "non trovato" };

// L'espressione finale DEVE essere la funzione stessa, non una chiamata -- klexir serve
// la applica lui, una volta per ogni richiesta che arriva davvero.
handleRequest
